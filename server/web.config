<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <!-- Let's Encrypt renews the certificate over plain http, and must not be redirected. -->
          <rule name="Leave .well-known alone" stopProcessing="true">
            <match url="^\.well-known/" />
            <action type="None" />
          </rule>
          <rule name="Send everyone to https" stopProcessing="true">
            <match url="(.*)" />
            <conditions logicalGrouping="MatchAny">
              <add input="{HTTPS}" pattern="off" />
              <add input="{HTTP_HOST}" pattern="^lanternfall\.bockersoftware\.dk$" negate="true" />
            </conditions>
            <action type="Redirect" url="https://lanternfall.bockersoftware.dk/{R:1}" redirectType="Permanent" />
          </rule>
        </rules>
      </rewrite>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\Lanternfall.Server.exe" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="OutOfProcess" />
    </system.webServer>
  </location>
</configuration>
